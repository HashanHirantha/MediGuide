-- 2. Update the profiles table (which is auto-created by the trigger) with doctor details
INSERT INTO public.profiles (id, email, first_name, last_name, role, is_active, profile_image, created_at, updated_at)
VALUES
  ('d1000000-0000-0000-0000-000000000001', 'nimal.perera@mediguide.lk', 'Nimal', 'Perera', 'doctor', true, 'https://i.pravatar.cc/150?img=11', now(), now()),
  ('d1000000-0000-0000-0000-000000000002', 'sunethra.silva@mediguide.lk', 'Sunethra', 'Silva', 'doctor', true, 'https://i.pravatar.cc/150?img=47', now(), now()),
  ('d1000000-0000-0000-0000-000000000003', 'ruwan.fernando@mediguide.lk', 'Ruwan', 'Fernando', 'doctor', true, 'https://i.pravatar.cc/150?img=32', now(), now())
ON CONFLICT (id) DO UPDATE SET 
  first_name = EXCLUDED.first_name, 
  last_name = EXCLUDED.last_name, 
  role = EXCLUDED.role,
  profile_image = EXCLUDED.profile_image;

-- 3. Insert Sri Lankan mock data into the doctors table
